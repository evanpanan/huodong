# 环境变量示例（复制成 .env 或直接写进 systemd/pm2 配置）
# 本项目不读 .env 文件，需要由启动器注入环境变量。

# 监听端口（反向代理转发到这里）
PORT=3000

# 数据目录（db.json、secret、backups 都在这里）
# 建议放到独立磁盘并纳入备份
DATA_DIR=./data

# 令牌签名密钥。留空会自动生成到 data/secret
# 多实例部署时必须显式指定同一个值
# APP_SECRET=请替换为32位以上随机字符串

# 单份表大小上限（MB）
MAX_DOC_MB=4

# 是否开放注册。1=开放；0=关闭（只能靠邀请加入，适合内部团队）
ALLOW_REGISTER=1
